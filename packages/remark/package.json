{
  "name": "@yamblog/remark",
  "version": "1.2.0",
  "description": "Remark plugins for @yamblog",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "remark": ">=14.0.0",
    "remark-directive": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "remark": {
      "optional": true
    },
    "remark-directive": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "@types/node": "^25.0.0",
    "remark": "^15.0.0",
    "remark-directive": "^3.0.0",
    "typescript": "^6.0.0"
  },
  "keywords": [
    "remark",
    "rehype",
    "blog",
    "markdown",
    "toc",
    "yamblog"
  ],
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamblog/yamblog.git",
    "directory": "packages/remark"
  },
  "homepage": "https://yamblog.dev",
  "bugs": "https://github.com/yamblog/yamblog/issues",
  "author": "Bharat Parsiya (https://bnap.dev)"
}
