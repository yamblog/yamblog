{
  "name": "yamblog",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "website",
    "examples/*"
  ],
  "scripts": {
    "validate:content": "bun run scripts/validate-content.ts",
    "build": "bun run validate:content && node scripts/build-changed.mjs --all --packages",
    "build:changed": "bun run validate:content && node scripts/build-changed.mjs",
    "test": "bun run build && bun run test:packages && bun run test:scripts",
    "test:packages": "bun run --filter './packages/*' test",
    "test:scripts": "bun test ./scripts",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "eslint packages scripts",
    "dev:website": "bun run --filter website dev",
    "example:next": "bun run --filter with-next dev",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "25.6.2",
    "eslint": "^9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "fflate": "^0.7.5"
  }
}
